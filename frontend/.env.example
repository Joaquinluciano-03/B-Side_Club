# Copia este archivo como .env (el .env real no se commitea).
# Vite solo le pasa al navegador las variables que empiezan con VITE_.

# Tiene que ser EXACTAMENTE la misma clave que API_KEY en el .env del backend,
# o todos los pedidos vuelven 401.
# OJO: esta clave viaja al navegador y cualquiera la puede leer desde las
# herramientas de desarrollo. No es un mecanismo de autenticacion: lo que
# protege de verdad las operaciones sensibles es el login con JWT.
VITE_API_KEY="la-misma-clave-que-API_KEY-del-backend"

# NO hace falta definirla: por defecto el frontend pide a "/api", o sea al
# mismo dominio. En Netlify eso lo atiende la funcion del backend, y en
# desarrollo lo reenvia el proxy de vite.config.js.
# Solo se completa si el backend se muda a OTRO dominio.
# VITE_API_URL="https://otro-host.com/api"
