// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Stock {
  disponible
  ultima_unidad
  reservado
  a_consultar
  vendido
}

enum TipoDescuento {
  porcentaje
  monto
}

enum Estado {
  pendiente
  leida
  respondida
}

enum Canal {
  whatsapp
  instagram
  formulario
}

enum Rol {
  super_admin
  administrador
  vendedor
}

enum InvitacionEstado {
  pendiente
  aceptada
  revocada
}

model User {
  id           Int                  @id @default(autoincrement())
  nombre       String
  apellido     String
  mail         String               @unique
  telefono     String // obligatorio: dato minimo de registro segun la consigna del TP
  passwordhash String
  rol          Rol // super_admin (dueño, unico, no se elimina), administrador o vendedor
  // version de las credenciales: sube al cambiar la contraseña y deja sin
  // efecto los tokens anteriores (ver middlewares/auth.js)
  tokenVersion Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  invitaciones Invitacion[]
  resetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiraEn  DateTime
  usado     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Invitacion {
  id            Int              @id @default(autoincrement())
  email         String
  token         String           @unique
  rol           Rol              @default(vendedor)
  estado        InvitacionEstado @default(pendiente)
  createdAt     DateTime         @default(now())
  expiraEn      DateTime
  invitadoPorId Int?
  invitadoPor   User?            @relation(fields: [invitadoPorId], references: [id])
}

model Categoria {
  id              Int        @id @default(autoincrement())
  nombre          String
  descripcion     String?
  // dibujo que la representa en el sitio (ver frontend/src/componentes/
  // IconoCategoria.jsx). null = el sitio lo deduce del nombre
  icono           String?
  // como se cuentan sus productos en el sitio ("4 títulos", "1 equipo").
  // null = "título" / "títulos"
  unidad_singular String?
  unidad_plural   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  productos       Producto[]
}

model StoreInfo {
  id          Int     @id @default(1)
  nombre      String
  direccion   String
  telefono    String?
  email       String?
  instagram   String?
  whatsapp    String?
  description String?
  horario     Json
}

model Producto {
  id              Int            @id @default(autoincrement())
  nombre          String
  anio            Int
  precio          Decimal? // null = "a consultar"
  // descuento opcional sobre el precio: un porcentaje (15 = 15%) o un monto
  // fijo en pesos. Los dos van juntos: o estan los dos, o ninguno
  descuento_tipo  TipoDescuento?
  descuento_valor Decimal?
  // precio con el descuento aplicado: lo calcula el backend al guardar (ver
  // producto.service) y es el que usa el filtro por rango de precio del catalogo
  precio_final    Decimal?
  stock           Int
  estado_stock    Stock          @default(disponible)
  condicion       String? // el estado varia mucho segun el tipo de producto (vinilo, cassette, equipo)
  genero          String? // genero musical (Rock nacional, Jazz...); null en equipos y accesorios
  destacado       Boolean        @default(false)
  esActivo        Boolean        @default(true)
  descripcion     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  categoriaId     Int
  categoria       Categoria      @relation(fields: [categoriaId], references: [id])
  imagenes        Imagen[]
  consultas       Consulta[]

  @@index([nombre]) // busqueda de publicaciones por nombre
  @@index([esActivo, destacado]) // listado publico: activos, y destacados de la home
}

model Imagen {
  id         Int      @id @default(autoincrement())
  url        String
  alt        String //descripcion de la imagen
  orden      Int      @default(0)
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Consulta {
  id         Int       @id @default(autoincrement())
  nombre     String
  email      String
  telefono   String?
  asunto     String
  mensaje    String
  canal      Canal
  estado     Estado    @default(pendiente)
  fecha      DateTime  @default(now())
  productoId Int? // opcional: la consulta puede no referirse a ningun producto del catalogo
  producto   Producto? @relation(fields: [productoId], references: [id])

  @@index([estado]) // panel: filtrar consultas por estado (pendiente/leida/respondida)
  @@index([fecha])
}

model Promocion {
  id          Int       @id @default(autoincrement())
  titulo      String
  descripcion String?
  imagenUrl   String?
  fechaInicio DateTime?
  fechaFin    DateTime?
  activa      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
