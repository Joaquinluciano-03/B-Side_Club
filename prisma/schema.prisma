// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Stock {
  disponible
  ultima_unidad
  reservado
  a_consultar
  vendido
}

enum Estado {
  pendiente
  leida
  respondida
}

enum Canal {
  whatsapp
  instagram
  formulario
}

enum Rol {
  super_admin
  administrador
  vendedor
}

enum InvitacionEstado {
  pendiente
  aceptada
  revocada
}

model User {
  id           Int                  @id @default(autoincrement())
  nombre       String
  apellido     String
  mail         String               @unique
  telefono     String // obligatorio: dato minimo de registro segun la consigna del TP
  passwordhash String
  rol          Rol // super_admin (dueño, unico, no se elimina), administrador o vendedor
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  invitaciones Invitacion[]
  resetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiraEn  DateTime
  usado     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Invitacion {
  id            Int              @id @default(autoincrement())
  email         String
  token         String           @unique
  rol           Rol              @default(vendedor)
  estado        InvitacionEstado @default(pendiente)
  createdAt     DateTime         @default(now())
  expiraEn      DateTime
  invitadoPorId Int?
  invitadoPor   User?            @relation(fields: [invitadoPorId], references: [id])
}

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String
  slug        String     @unique
  descripcion String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  productos   Producto[] 
}

model StoreInfo {
  id          Int     @id @default(1) 
  nombre      String
  direccion   String
  telefono    String?
  email       String?
  instagram   String?
  whatsapp    String?
  description String?
  horario     Json
}

model Producto {
  id           Int        @id @default(autoincrement())
  nombre       String
  anio         Int
  precio       Decimal? // null = "a consultar"
  stock        Int
  estado_stock Stock      @default(disponible)
  condicion    String? // el estado varia mucho segun el tipo de producto (vinilo, cassette, equipo)
  destacado    Boolean    @default(false)
  esActivo     Boolean    @default(true)
  descripcion  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  categoriaId  Int
  categoria    Categoria  @relation(fields: [categoriaId], references: [id])
  imagenes     Imagen[]
  consultas    Consulta[]

  @@index([nombre]) // busqueda de publicaciones por nombre
  @@index([esActivo, destacado]) // listado publico: activos, y destacados de la home
}

model Imagen {
  id         Int      @id @default(autoincrement())
  url        String
  alt        String //descripcion de la imagen
  orden      Int      @default(0)
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Consulta {
  id         Int       @id @default(autoincrement())
  nombre     String
  email      String
  telefono   String?
  asunto     String
  mensaje    String
  canal      Canal
  estado     Estado    @default(pendiente)
  fecha      DateTime  @default(now())
  productoId Int? // opcional: la consulta puede no referirse a ningun producto del catalogo
  producto   Producto? @relation(fields: [productoId], references: [id])

  @@index([estado]) // panel: filtrar consultas por estado (pendiente/leida/respondida)
  @@index([fecha])
}
