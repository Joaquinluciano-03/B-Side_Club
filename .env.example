# Copia este archivo como .env y completa los valores reales.
# El .env real NUNCA se commitea (esta en .gitignore).

# Conexion a Postgres (Supabase). DIRECT_URL la usa Prisma para migraciones,
# DATABASE_URL la usa el backend en runtime.
DATABASE_URL="postgresql://usuario:password@host:5432/postgres"
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

# Puerto donde levanta el servidor Express
PORT=3000

# Cantidad de proxies delante del servidor. Los limites de pedidos cuentan por
# IP, y detras de un proxy (Render, Railway, nginx) todos los pedidos llegan
# con la IP del proxy, asi que el limite se aplicaria a todos los usuarios
# juntos. En local se deja vacia; en produccion normalmente va TRUST_PROXY=1.
TRUST_PROXY=

# Autenticacion (JWT)
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# API key interna: el frontend la manda en el header x-api-key en cada pedido a /api/*.
# Es una capa previa al JWT (filtra clientes que no son nuestro frontend), no reemplaza al login.
# Quedan afuera /api/health y /uploads. Tiene que ser el mismo valor que VITE_API_KEY en el frontend.
# Generar una nueva con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY="cambiar-por-una-clave-generada-con-el-comando-de-arriba"

# Supabase Storage: ahi se guardan las imagenes de los productos.
# Hacen falta porque el backend corre como funcion de Netlify y no tiene disco
# propio donde escribir archivos.
# Las dos salen de Supabase > Project Settings > API.
# La service_role key es de SERVIDOR: saltea las policies de seguridad, nunca
# puede terminar en el frontend ni commitearse.
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="pegar-la-service-role-key"

# Dominios del frontend habilitados para consumir la API desde el navegador, separados por coma.
# En produccion el frontend y la API quedan en el MISMO dominio (Netlify manda
# /api/* a la funcion), asi que CORS no llega a intervenir. Igual se deja
# configurada por si alguna vez se consume la API desde otro lado.
# En desarrollo tampoco hace falta: el proxy de Vite hace que el navegador vea
# todo en localhost:5173.
#   CORS_ORIGINS="http://localhost:5173,https://bside-club.netlify.app"
CORS_ORIGINS="http://localhost:5173"

# URL del frontend, se usa para armar los links de invitacion y de recuperar contraseña
FRONTEND_URL="http://localhost:5173"

# SMTP para el envio real de mails (invitaciones, recuperar contraseña).
# Si se dejan vacias, el backend loguea el mail por consola en vez de enviarlo (modo dev).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="B-Side Club <no-reply@bsideclub.com>"
