# Copia este archivo como .env y completa los valores reales.
# El .env real NUNCA se commitea (esta en .gitignore).

# Conexion a Postgres (Supabase). DIRECT_URL la usa Prisma para migraciones,
# DATABASE_URL la usa el backend en runtime.
DATABASE_URL="postgresql://usuario:password@host:5432/postgres"
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

# Puerto donde levanta el servidor Express
PORT=3000

# Autenticacion (JWT)
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# API key interna: el frontend la manda en el header x-api-key en cada pedido a /api/*.
# Es una capa previa al JWT (filtra clientes que no son nuestro frontend), no reemplaza al login.
# Quedan afuera /api/health y /uploads. Tiene que ser el mismo valor que VITE_API_KEY en el frontend.
# Generar una nueva con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY="cambiar-por-una-clave-generada-con-el-comando-de-arriba"

# Dominios del frontend habilitados para consumir la API desde el navegador, separados por coma.
# En produccion se agrega el dominio real, por ejemplo:
#   CORS_ORIGINS="http://localhost:5173,https://bsideclub.com"
# Si queda vacia no se permite ningun dominio (el backend avisa por consola al arrancar).
CORS_ORIGINS="http://localhost:5173"

# URL del frontend, se usa para armar los links de invitacion y de recuperar contraseña
FRONTEND_URL="http://localhost:5173"

# SMTP para el envio real de mails (invitaciones, recuperar contraseña).
# Si se dejan vacias, el backend loguea el mail por consola en vez de enviarlo (modo dev).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="B-Side Club <no-reply@bsideclub.com>"
